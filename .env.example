# ------------------------------------------------------------------
# Mureeh frontend & Supabase environment variables.
#
# RULE: only values safe for browser exposure may use the NEXT_PUBLIC_
# prefix. Secrets (service keys, JWT signing keys, DB URLs) must NEVER
# appear in any client bundle — they belong to the backend.
# ------------------------------------------------------------------

# Base URL of the auth/REST API when USE_MOCK is disabled.
# Leave empty to use same-origin relative paths (recommended with Next rewrites/proxy).
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------
# Supabase & PostgreSQL Configuration
# ------------------------------------------------------------------
# 1. DATABASE_URL: Transaction Pooler connection string (Port 6543) or direct connection from Supabase Project Settings -> Database.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct / Session connection string (Port 5432) used for Prisma migrations and schema push.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# 3. Supabase Public Project URL and Anon Key (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# 4. Optional: Supabase Service Role Key (Backend only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Optional: absolute public origin for links written into outbox messages
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
