# ------------------------------------------------------------------
# Mureeh environment variables.
#
# RULE: only values safe for browser exposure may use the NEXT_PUBLIC_
# prefix. Secrets (service keys, JWT signing keys, DB URLs) must NEVER
# appear in any client bundle — they belong to the server.
# ------------------------------------------------------------------

# Base URL of the REST API when a service runs against real HTTP.
# Leave empty to use same-origin relative paths (recommended).
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------
# PostgreSQL (via Prisma)
# ------------------------------------------------------------------
# Prisma is the persistence abstraction. Any PostgreSQL provider works
# (managed or self-hosted) — only these two connection strings change.
#
# 1. DATABASE_URL — the connection the application uses at runtime.
#    With a pooled endpoint, point this at the transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# 2. DIRECT_URL — a non-pooled connection used by Prisma CLI for
#    migrations (`prisma migrate deploy`) and schema push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------
# The gateway integration suite runs against a real, DISPOSABLE
# PostgreSQL database — never the development one.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:5432/mureeh_test"

# ------------------------------------------------------------------
# AI question generation (optional)
# ------------------------------------------------------------------
# Without a key the deterministic fallback generator is used, so the
# product is fully functional offline. Keys are server-only.
GEMINI_API_KEY=

# Optional: absolute public origin for links written into outbox messages
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
