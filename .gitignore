# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production
/build

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Databases
*.db
*.db-journal
/prisma/data/*.db
/prisma/data/*.db-journal

# Local development PostgreSQL data directory (created by
# scripts/local-postgres.mjs). It is a live cluster, never source: it holds
# rows, WAL segments and the server's own key material.
/.pgdata/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Files
.DS_Store
*.pem
Thumbs.db

# TypeScript cache
*.tsbuildinfo
