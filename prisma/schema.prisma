// ================================================================
// MUREEH OFFICIAL AUTH GATEWAY — persistent store
//
// PostgreSQL via Prisma. Prisma is the persistence abstraction: the
// application talks to the Prisma client only, so any PostgreSQL
// provider (managed or self-hosted) works by editing `DATABASE_URL`
// alone — no application code changes.
// ================================================================

generator client {
  provider   = "prisma-client-js"
  // Driver-adapter engine: queries are compiled by the WASM query compiler
  // shipped with @prisma/client and executed through @prisma/adapter-pg.
  // No native query-engine binary is fetched at install time, and the
  // PostgreSQL driver is an explicit application dependency instead of a
  // hidden engine download.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Accounts for every portal (gateways): student, guardian, admin.
/// `status` is the official lifecycle: pending → active | suspended.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              String // student | guardian | admin
  nationalId        String?   @unique
  status            String    @default("pending") // pending | active | suspended
  emailVerification String    @default("verified") // invitation registration explicitly starts pending
  onboarding        String    @default("not-started") // drives post-auth routing
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  sentInvitations   Invitation[]  @relation("Inviter")
  acceptedInvite    Invitation[]  @relation("Invitee")
  auditAsActor      AuditEvent[]  @relation("Actor")

  // Learning aggregates. All are owned by the student and cascade with the
  // account: there is no orphaned learning data by design.
  assessmentSessions AssessmentSession[]
  goals              Goal[]
  roadmaps           Roadmap[]
  unitExecutions     LearningUnitExecution[]
  auditAsSubject    AuditEvent[]  @relation("Subject")
  resetTokens       PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  learningEvents     LearningEvent[]
  evidences          Evidence[]
  conceptStates      ConceptState[]
  recallSchedules    RecallSchedule[]
  testAttempts       TestAttempt[]
  guardianLinks      GuardianRelation[] @relation("GuardianLink")
  studentLinks       GuardianRelation[] @relation("StudentLink")
}

/// Server-side sessions. Only the SHA-256 of the cookie token is
/// stored — a database leak can never be replayed as a session.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Institutional registration: accounts exist only through an
/// invitation issued by the administration portal.
model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String
  role        String // student | guardian
  nationalId  String?
  note        String?
  status      String    @default("pending") // pending | accepted | revoked
  invitedById String
  acceptedById String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  invitedBy User? @relation("Inviter", fields: [invitedById], references: [id])
  acceptedBy User? @relation("Invitee", fields: [acceptedById], references: [id])

  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Single-use email verification token. Only the SHA-256 hash is persisted.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail for every security-relevant action.
model AuditEvent {
  id        String   @id @default(cuid())
  type      String // login_success | login_failed | login_locked | logout | register_pending | approval | suspension | session_revocation | password_reset ...
  userId    String?
  actorId   String?
  ip        String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  user  User? @relation("Subject", fields: [userId], references: [id])
  actor User? @relation("Actor", fields: [actorId], references: [id])

  @@index([createdAt])
}

/// Auth email delivery history. Production sends via SMTP and tracks each
/// attempt; development/tests keep a local outbox. Production message bodies
/// redact one-time tokens and invitation codes.
model OutboxMessage {
  id                String    @id @default(cuid())
  to                String
  subject           String
  body              String
  kind              String // invite | reset | welcome | verification
  deliveryStatus    String    @default("pending") // pending | sent | failed
  deliveryAttempts  Int       @default(0)
  deliveredAt       DateTime?
  lastDeliveryError String? // safe category only; never provider text
  createdAt         DateTime  @default(now())

  @@index([createdAt])
}

// ================================================================
// LEARNING DOMAIN — Phase 2 persistence
//
// Only aggregates that already have a domain engine, a persistence port
// and tests are modelled here. Concepts without an implemented domain
// (missions, recall, tests, mastery, recovery, behaviour, mentor,
// achievements) are deliberately NOT modelled — see
// docs/PHASE_2_REPORT.md §3 for the classification and where each belongs.
//
// Value objects are stored as Json on their aggregate root: they have no
// independent identity, lifecycle or query pattern, so giving them tables
// would be modelling for its own sake.
// ================================================================

/// A diagnostic assessment session. Owned by exactly one student.
///
/// `topicState` is the engine's incremental coverage accumulator; it is
/// written atomically with the session, never partially.
model AssessmentSession {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// in_progress | paused | completed | expired
  status      String    @default("in_progress")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// Per-topic { asked, points, lastDifficulty, lastPoints }. Engine-owned.
  topicState  Json      @default("{}")
  lastTopic   String?
  /// Diagnostic profile supplied before starting, when present.
  profile     Json?
  /// Topic ids this session draws from (static bank or generated set).
  sessionTopics String[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   AssessmentQuestion[]
  answers     AssessmentAnswer[]

  // getActiveSession: the student's unfinished session.
  @@index([studentId, status])
  // getLatestCompletedResult: newest completed diagnosis.
  @@index([studentId, completedAt(sort: Desc)])
}

/// One question in a session's bank.
///
/// SECURITY: `scoring` is the ANSWER KEY. It lives in its own column on its
/// own table so the internal/public boundary is structural rather than a
/// convention someone has to remember. Only `question` may ever be served.
model AssessmentQuestion {
  id         String            @id @default(cuid())
  sessionId  String
  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// The engine's question id. Deterministic ids (e.g. `fn_f1`) repeat
  /// across sessions, so uniqueness is scoped to the session.
  questionId String
  topic      String
  difficulty String
  /// Public content: prompt, instructions, context, options. Safe to serve.
  question   Json
  /// INTERNAL answer key: { kind, correctOptionId } | { kind, keywords, minMatches }.
  scoring    Json

  answers    AssessmentAnswer[]

  @@unique([sessionId, questionId])
}

/// One graded response.
///
/// `points` is computed by the engine from `AssessmentQuestion.scoring`.
/// There is no client-writable correctness column anywhere in this schema.
model AssessmentAnswer {
  id           String             @id @default(cuid())
  sessionId    String
  session      AssessmentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assessmentQuestionId String
  question     AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  /// Client-generated idempotency key. The unique constraint below is what
  /// makes a retried submission safe under concurrency — not an
  /// `if (!existing)` check in application code.
  submissionId String
  /// The student's response ONLY: { type, questionId, optionId | answer }.
  response     Json
  /// 1 correct · 0.5 partial · 0 incorrect. Server-derived.
  points       Float
  difficulty   String
  questionType String
  submittedAt  DateTime           @default(now())

  @@unique([sessionId, submissionId])
  @@index([sessionId])
}

/// A learning goal. Owned by exactly one student.
///
/// `version` is bumped on every accepted mutation and is the optimistic
/// concurrency token. The two idempotency keys have partial-unique
/// semantics: NULL means "no key supplied", and PostgreSQL treats NULLs as
/// distinct, so keyless goals never collide.
model Goal {
  id                   String    @id @default(cuid())
  studentId            String
  student              User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// discovered | validated | needs_revision | locked | revised | archived
  status               String    @default("discovered")
  desiredOutcome       String
  currentLevel         String
  targetLevel          String
  motivation           Json
  targetDomain         Json
  timeframe            Json
  weeklyCommitment     Json
  constraints          String[]  @default([])
  successCriteria      String[]  @default([])
  /// Diagnosis snapshot at creation time, when the student had one.
  diagnosisContext     Json?
  /// Latest engine validation, persisted with the goal.
  validation           Json?
  version              Int       @default(1)
  createIdempotencyKey String?
  lockIdempotencyKey   String?
  revisesGoalId        String?
  revisesGoal          Goal?     @relation("GoalRevision", fields: [revisesGoalId], references: [id])
  revisions            Goal[]    @relation("GoalRevision")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lockedAt             DateTime?

  roadmaps             Roadmap[]

  @@unique([studentId, createIdempotencyKey])
  @@unique([studentId, lockIdempotencyKey])
  // getActiveGoal: the student's current non-terminal goal.
  @@index([studentId, status])
}

/// A generated learning path for one locked goal.
///
/// `generationKey` (studentId:goalId:goalVersion:engineVersion) is the
/// idempotency anchor. It was previously enforced by an in-memory scan,
/// which races; the unique constraint makes a concurrent duplicate
/// generation impossible. `@@unique([studentId, version])` does the same
/// for the monotonic version counter.
model Roadmap {
  id                  String    @id @default(cuid())
  studentId           String
  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  goalId              String
  goal                Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  version             Int       @default(1)
  /// draft | active | paused | completed | revised
  status              String    @default("draft")
  title               String
  description         String
  weeklyCommitment    Float
  totalEstimatedHours Float
  estimatedDuration   Json
  timeFeasibility     Json
  /// { goalVersion, engineVersion, diagnosisSessionId?, generationKey,
  ///    availableHours, requiredHours }
  generationContext   Json
  generationKey       String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  milestones          RoadmapMilestone[]
  learningUnits       LearningUnit[]
  executions          LearningUnitExecution[]

  @@unique([studentId, version])
  // getActiveRoadmap: the student's current path.
  @@index([studentId, status])
  @@index([goalId])
}

/// An ordered milestone within one roadmap.
///
/// The domain id (`ms_<capabilityId>`) is deterministic and therefore
/// REPEATS across roadmap versions, so it cannot be the primary key. It is
/// kept as `milestoneId`, unique within its roadmap, and referenced by that
/// pair from learning units and executions.
model RoadmapMilestone {
  id              String   @id @default(cuid())
  roadmapId       String
  roadmap         Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  /// Domain id, stable and readable. Unique per roadmap only.
  milestoneId     String
  capabilityId    String
  title           String
  description     String
  order           Int
  status          String
  learningOutcome String
  estimatedHours  Float
  goalAlignment   String
  maintenance     Boolean  @default(false)
  /// Milestone domain ids that must come first (prerequisite closure).
  dependencies    String[] @default([])
  checkpoint      Json

  learningUnits   LearningUnit[]

  @@unique([roadmapId, milestoneId])
  @@unique([roadmapId, order])
}

/// An ordered learning unit inside a milestone.
///
/// Same reasoning as milestones: the domain id
/// (`unit_<capabilityId>_<slotType>`) is deterministic and repeats across
/// roadmap versions.
model LearningUnit {
  id                 String           @id @default(cuid())
  roadmapId          String
  roadmap            Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestoneId        String
  milestone          RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /// Domain id, unique within the roadmap.
  unitId             String
  type               String
  order              Int
  title              String
  purpose            String
  estimatedMinutes   Int
  expectedOutcome    String
  completionEvidence String

  executions         LearningUnitExecution[]

  @@unique([roadmapId, unitId])
  @@unique([milestoneId, order])
  @@index([roadmapId])
}

/// A student's attempt at one learning unit in one roadmap.
///
/// One record per (roadmap, unit): a retry mutates the existing record
/// rather than appending, so the unique constraint below encodes a real
/// domain invariant. An execution cannot reference a unit that does not
/// exist in its roadmap — the composite foreign key enforces that.
model LearningUnitExecution {
  id             String       @id @default(cuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roadmapId      String
  roadmap        Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestoneId    String
  /// Learning unit DOMAIN id, paired with roadmapId.
  learningUnitId String
  learningUnit   LearningUnit @relation(fields: [roadmapId, learningUnitId], references: [roadmapId, unitId], onDelete: Cascade)
  /// in_progress | submitted | evaluated
  status         String
  startedAt      DateTime?
  submittedAt    DateTime?
  evaluatedAt    DateTime?
  evidence       Json?
  result         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([roadmapId, learningUnitId])
  @@index([studentId, status])
  @@index([roadmapId])
}

// ================================================================
// LEARNING INTELLIGENCE — Phase 4+ persistence
//
// Concepts, events, evidence, concept-states, recall and tests
// form the intelligence substrate the mastery/diagnosis/adaptive
// engines read. Each has an identity, owner, lifecycle and query
// pattern — so each earns a table. Value-object-only data stays
// as Json on the aggregate root.
// ================================================================

/// Canonical concept catalog. One row per learnable concept, not per
/// student. LearningUnit and Evidence point AT it; ConceptState points
/// at it per student. Prerequisites are explicit concept ids, so the
/// graph is queryable and prerequisites are not free text.
model Concept {
  id            String   @id @default(cuid())
  name          String
  description   String
  domain        String
  prerequisites String[] @default([])
  difficulty    Int      @default(1) // 1..5
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conceptStates ConceptState[]
  evidences     Evidence[]
  recallSchedules RecallSchedule[]

  @@unique([name, domain])
  @@index([domain])
}

/// Append-only learning event stream. The source of truth for
/// rebuilding learner state from real evidence. Privacy-bounded:
/// every row carries its studentId and is always queried through it.
model LearningEvent {
  id            String   @id @default(cuid())
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type          String
  timestamp     DateTime @default(now())
  source        String   // api | engine | system
  entityType    String
  entityId      String
  payload       Json
  schemaVersion Int      @default(1)
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([studentId, type])
  @@index([studentId, timestamp(sort: Desc)])
  @@index([correlationId])
  @@index([entityType, entityId])
}

/// Generalized evidence. One row per observable learner action that
/// proves (or fails to prove) something. Immutable after evaluation
/// where appropriate; versioned where revision matters.
model Evidence {
  id                  String    @id @default(cuid())
  studentId           String
  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptId           String?
  concept             Concept?  @relation(fields: [conceptId], references: [id])
  kind                String    // answer | reasoning | solution | code | explanation | quiz_result | recall_result | transfer_result | hint_usage
  payload             Json
  score               Float?    // 0..1
  timeSpentSeconds    Int?
  attemptCount        Int       @default(1)
  hintUsed            Boolean   @default(false)
  hintCount           Int       @default(0)
  learningUnitId      String?
  roadmapId           String?
  assessmentSessionId String?
  testAttemptId       String?
  immutable           Boolean   @default(false)
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([studentId, conceptId])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([conceptId])
}

/// Per-student, per-concept learner state. Not a single mastery
/// percentage — a decomposed, source-traceable vector.
model ConceptState {
  id                String    @id @default(cuid())
  studentId         String
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptId         String
  concept           Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  knowledge         Float     @default(0)
  retrieval         Float     @default(0)
  retention         Float     @default(0)
  transfer          Float     @default(0)
  fluency           Float     @default(0)
  confidence        Float     @default(0)
  hintDependency    Float     @default(0)
  misconceptionRisk Float     @default(0)
  evidenceCount     Int       @default(0)
  lastEvidenceAt    DateTime?
  stateVersion      Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([studentId, conceptId])
  @@index([studentId])
  @@index([conceptId])
}

/// Evidence-driven recall schedule. One row per concept that has
/// been studied; existence means the system knows when to ask again.
model RecallSchedule {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptId      String
  concept        Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  evidenceId     String?
  intervalDays   Int       @default(1)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  state          String    @default("new") // new | learning | review | relearning
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, conceptId])
  @@index([studentId, dueAt])
  @@index([conceptId])
}

/// Server-owned test definition. The question bank lives here,
/// never in the client bundle.
model TestDefinition {
  id               String   @id @default(cuid())
  title            String
  moduleId         String?
  phaseTitle       String?
  timeLimitMinutes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions TestQuestion[]
  attempts  TestAttempt[]
}

model TestQuestion {
  id                 String         @id @default(cuid())
  testId             String
  test               TestDefinition @relation(fields: [testId], references: [id], onDelete: Cascade)
  kind               String         // multiple_choice | short_answer | scenario | problem_solving
  prompt             String
  choices            Json?
  correctChoiceIndex Int?
  explanation        String
  topic              String
  points             Int            @default(1)
  rubric             Json?

  @@index([testId])
}

/// Server-graded attempt. The verdict is never accepted from the client.
model TestAttempt {
  id               String         @id @default(cuid())
  studentId        String
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId           String
  test             TestDefinition @relation(fields: [testId], references: [id], onDelete: Cascade)
  status           String         @default("submitted")
  score            Float          @default(0) // 0..100
  timeSpentSeconds Int
  answers          Json
  gradedAnswers    Json?
  strongTopics     String[]       @default([])
  needsReviewTopics String[]      @default([])
  recommendation   String?
  createdAt        DateTime       @default(now())

  @@index([studentId, testId])
  @@index([testId])
}

/// Explicit guardian ↔ student relationship. Server-side ownership
/// and minimal exposure; never `studentId` from client as authority.
model GuardianRelation {
  id         String   @id @default(cuid())
  guardianId String
  guardian   User     @relation("GuardianLink", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("StudentLink", fields: [studentId], references: [id], onDelete: Cascade)
  status     String   @default("active") // pending | active | revoked
  createdAt  DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([studentId])
}
